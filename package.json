{
  "name": "fractal-arena-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App Android native de Fractal Arena (Capacitor) - www/ genere depuis le client web",
  "scripts": {
    "build:web": "node scripts/sync-web.mjs",
    "icones": "node scripts/app-icons.mjs",
    "sync": "npm run build:web && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "node scripts/build-release.mjs",
    "bundle": "node scripts/build-bundle.mjs",
    "ouvrir": "cap open android"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capgo/capacitor-updater": "^6.51.23"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
